{
  "name": "@suretyainpm/suretyai",
  "version": "0.2.1",
  "description": "The open execution boundary for autonomous AI agents — deterministic gates, hard limits, and tamper-evident action receipts.",
  "keywords": [
    "ai-agents",
    "guardrails",
    "agent-governance",
    "human-in-the-loop",
    "audit-trail",
    "action-receipt",
    "mcp",
    "execution-boundary",
    "trust"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/balureddy003/suretyai.git"
  },
  "homepage": "https://github.com/balureddy003/suretyai#readme",
  "bugs": {
    "url": "https://github.com/balureddy003/suretyai/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "spec",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "tsx evals/run.ts && tsx evals/simulation/run.ts",
    "eval:simulation": "tsx evals/simulation/run.ts",
    "examples": "for f in examples/0*.ts; do echo \"\\n━━━ $f ━━━\"; tsx \"$f\" || exit 1; done",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.evals.json",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
